/* =================== STEP 1: chunk digest (video dekhta hai) =================== */
function normalizeDigest(data: any, start: number, end: number): ChunkDigest {
  const len = end - start;
  const m = data.meta;
  const meta: LangMeta | undefined = m
    ? {
        detected_medium: (['english', 'hindi', 'hinglish'] as Medium[]).includes(m.detected_medium) ? m.detected_medium : 'hinglish',
        detected_subject: String(m.detected_subject || 'General'),
        detected_board: String(m.detected_board || 'Unknown'),
      }
    : undefined;
  const segs: Segment[] = (data.segments || []).filter((s: Segment) => s && s.title && s.summary);
  const board: BoardItem[] = (data.board || []).filter((b: BoardItem) => b && b.title);
  let maxT = 0;
  segs.forEach((s) => (maxT = Math.max(maxT, s.t || 0)));
  board.forEach((b) => (maxT = Math.max(maxT, b.t || 0, b.best_t || 0)));
  // Gemini kabhi clip-relative, kabhi absolute seconds deta hai
  const off = start > 0 && maxT > len + 5 ? 0 : start;
  const fix = (v: number) => clamp(Math.round((v || 0) + off), start, end);
  return {
    meta,
    segments: segs.map((s) => ({ ...s, t: fix(s.t) })),
    board: board.map((b) => {
      const bt = fix(b.best_t || b.t);
      return {
        ...b,
        id: `b${bt}`,
        t: fix(b.t),
        best_t: bt,
        kind: b.kind || 'diagram',
        importance: clamp(Math.round(b.importance || 2), 1, 3),
      };
    }),
  };
}

async function fetchDigest(
  videoUrl: string,
  start: number,
  end: number,
  stop: Stop,
  opts: { title: string; withMeta: boolean },
  depth = 0
): Promise<ChunkDigest> {
  const prompt = `Tum ek dhyaan se padhne wale topper student ho. Is lecture ke ${fmt(start)} se ${fmt(end)} wale hisse ko dhyan se SUNO aur DEKHO.${opts.title ? `\nVideo title (hint): ${opts.title}` : ''}

Is hisse ko concept-wise "segments" mein todo (har segment = ek topic/concept/example, lagbhag 1-3 minute). Har segment mein:
- "t": segment shuru hone ka time SECONDS mein, is clip ke shuru se (clip start = 0).
- "title": chhota topic naam.
- "summary": teacher ne jo samjhaya uska 3-5 vakya ka poora saar. Koi important baat skip mat karo. Word-by-word copy mat karo, samajh kar likho.
- "definition": agar teacher ne koi definition/meaning boli, ek saaf vakya mein, usi bhasha mein jisme teacher ne boli (English boli toh English mein). Nahi boli toh "".
- "intuition": teacher ne use aasaan bhasha mein kaise samjhaya (analogy, kahani, roz ki misaal, tarkeeb). Nahi hai toh "".
- "examples": teacher ne jo examples/numericals karaye (chhote). Nahi hai toh [].
- "formulas": jo formula/equation bola ya likha (symbols ke saath). Nahi hai toh [].
- "important": SIRF tab, jab teacher khud kahe ki ye important hai / yaad rakho / likh lo / exam mein aata hai / dhyan do. Uski baat ek line mein. Warna "".

Board/screen par jab koi asli drawing bane (circuit, diagram, graph, figure, flowchart, table), usse "board" mein daalo:
- "title", "kind" (diagram/circuit/graph/table/flowchart/figure), "description" (kya shape hai, kaun si labels/values hain, sirf jo dikh raha hai)
- "t": jab banana shuru kare, "best_t": jab POORA bana ho aur saari labels likhi hon (clip-relative seconds)
- "importance": 3 = concept samajhne ke liye zaroori, 2 = madadgaar, 1 = chhoti/saadharan cheez.
Sirf asli drawings daalo. Sirf text/heading ho toh board khali rakho.

BHASHA: teacher jis bhasha mein bole usi mein likho - Hindi bole toh Devanagari Hindi, English bole toh English, mixed bole toh mixed. Technical terms aur definitions waise hi jaise teacher ne boli (English term English mein).

STRICT: sirf video mein jo hai wahi likho, bahar ki jaankari mat jodo. Intro, advertisement, "like subscribe" jaisi cheezein chhod do.${opts.withMeta ? metaPrompt() : ''}`;

  try {
    const res = await callGemini(
      [
        {
          role: 'user',
          parts: [
            { fileData: { fileUri: videoUrl }, videoMetadata: { startOffset: `${start}s`, endOffset: `${end}s` } },
            { text: prompt },
          ],
        },
      ],
      {
        responseMimeType: 'application/json',
        responseSchema: opts.withMeta ? digestSchemaWithMeta : digestSchema,
        mediaResolution: CONFIG.VIDEO_RES as any,
        maxOutputTokens: 12000,
      },
      stop
    );
    return normalizeDigest(parseJson(res?.text), start, end);
  } catch (e: any) {
    const msg = String(e?.message || '');
    if (msg === 'CANCELLED' || /API key|PERMISSION_DENIED|INVALID_ARGUMENT|private|unsupported/i.test(msg)) throw e;
    // output kat gaya / JSON toota / baar baar fail: chunk ko aadha karke dobara
    if (depth < 1 && end - start >= 240) {
      const mid = start + Math.floor((end - start) / 2);
      const a = await fetchDigest(videoUrl, start, mid, stop, opts, depth + 1);
      const b = await fetchDigest(videoUrl, mid, end, stop, { ...opts, withMeta: false }, depth + 1);
      return { meta: a.meta, segments: [...a.segments, ...b.segments], board: [...a.board, ...b.board] };
    }
    throw e;
  }
}

/* =================== STEP 2: outline (sirf text, halka) =================== */
function uniformOutline(durationSec: number): Chapter[] {
  const out: Chapter[] = [];
  for (let s = 0, i = 1; s < durationSec; s += 600, i++) {
    out.push({ title: `Part ${i}`, start_sec: s, end_sec: Math.min(s + 600, durationSec) });
  }
  return out;
}

async function buildOutline(segments: Segment[], durationSec: number, lang: LangProfile, stop: Stop): Promise<Chapter[]> {
  const list = segments.map((s) => `[${fmt(s.t)}] ${s.title}`).join('\n');
  const short = durationSec < 20 * 60;
  const prompt = `Neeche ek class lecture ke topics ki list hai (format: [mm:ss] topic). Inhe chapters mein baanto, jaise teacher board par heading likhta hai.
Rules:
- ${short ? '2 se 4 chapters' : 'Har chapter lagbhag 8-15 minute ka, kul 4 se 16 chapters'}.
- Pehle chapter ka start_sec = 0, har agle ka start_sec = pichle ka end_sec, aakhri ka end_sec = ${durationSec}.
- Ek concept ko beech se mat todo.
- Chapter titles ko neeche ke LANGUAGE RULES ke hisaab se likho.

${languageRules(lang)}

TOPICS:
${list}`;

  try {
    const res = await callGemini(
      [{ role: 'user', parts: [{ text: prompt }] }],
      { responseMimeType: 'application/json', responseSchema: outlineSchema, maxOutputTokens: 4096 },
      stop
    );
    let chapters: Chapter[] = (parseJson(res?.text).chapters || [])
      .filter((c: Chapter) => c && c.title)
      .sort((a: Chapter, b: Chapter) => a.start_sec - b.start_sec);
    if (chapters.length === 0) return uniformOutline(durationSec);
    chapters[0].start_sec = 0;
    for (let i = 0; i < chapters.length - 1; i++) chapters[i].end_sec = chapters[i + 1].start_sec;
    chapters[chapters.length - 1].end_sec = durationSec;
    chapters = chapters.filter((c) => c.end_sec > c.start_sec);
    return chapters.length ? chapters : uniformOutline(durationSec);
  } catch (e: any) {
    if (String(e?.message) === 'CANCELLED') throw e;
    return uniformOutline(durationSec);
  }
}

/* =================== STEP 3: student-style notes + mind map + MCQs =================== */
function segmentsToText(segs: Segment[]): string {
  return segs
    .map((s) => {
      const lines = [`[${fmt(s.t)}]${s.important ? ' ★' : ''} ${s.title}`, `Saar: ${s.summary}`];
      if (s.definition) lines.push(`Teacher ki definition: ${s.definition}`);
      if (s.intuition) lines.push(`Teacher ne aise samjhaya: ${s.intuition}`);
      if (s.examples?.length) lines.push(`Examples: ${s.examples.join(' | ')}`);
      if (s.formulas?.length) lines.push(`Formulas: ${s.formulas.join(' | ')}`);
      if (s.important) lines.push(`Teacher ne bola (important): ${s.important}`);
      return lines.join('\n');
    })
    .join('\n\n');
}

async function buildChapter(ch: Chapter, allSegs: Segment[], lang: LangProfile, stop: Stop): Promise<{ notes: ChapterContent; mcqs: MCQ[] }> {
  const segs = allSegs.filter((s) => s.t >= ch.start_sec && s.t < ch.end_sec);
  if (segs.length === 0) return { notes: { sections: [], terms: [], important_points: [], quick_revision: [] }, mcqs: [] };

  const mins = (ch.end_sec - ch.start_sec) / 60;
  const mcqCount = clamp(Math.round(mins / 1.5), 5, 14);

  const prompt = `Tum ek topper student ho jo class ke baad apni notebook mein saaf, samajhdaar notes banata hai. Neeche chapter "${ch.title}" ke teacher-segments hain (★ = teacher ne khud important bola).

${languageRules(lang)}

A) NOTES (notebook style):
Har concept ke liye ek "section":
- "heading": jaise board par likhte hain.
- "start_sec": segment ka time (seconds, poore video ke hisaab se, jahan se ye concept shuru hua).
- "definition": clear, saaf vakya mein "X kya hai". Agar teacher ne definition aur explanation dono di hain, toh pehle definition yahan likho.
- "intuition": teacher ne use kaise aasaan bhasha mein samjhaya (analogy/roz ki misaal) - student ke samajhne ke liye. Dono ko naturally mila kar likho, bas teacher ke shabdon ki copy nahi.
- "points": 3-6 chhote, crisp points (max 12 shabd), keywords ke saath, jaise student shortcut mein likhta hai.
- "examples": teacher ke diye real-life examples / numericals.
- "formulas": "V = I × R  (matlab: ...)" is tarah, symbols ke saath.
- "exam_tip": sirf agar teacher ne exam/yaad rakhne ki baat boli ho.
Jo field teacher ne nahi di, usse "" ya [] rakho. Kuch bhi apni taraf se mat gadho.

Chapter-level:
- "intro": 1 line.
- "terms": important shabd + chhota matlab.
- "important_points": ★ wali baaton se, student ki tarah chhote vakya mein. Nahi hai toh [].
- "quick_revision": 4-7 one-line takeaways, exam se pehle padhne ke liye.
- "mindmap": center = chapter naam, 3-6 branches, har ek ke 2-4 children (1-3 shabd).

B) MCQs - exactly ${mcqCount}, exam-level aur concept-based (question, options aur explanation ki bhasha upar ke LANGUAGE RULES ke hisaab se):
- "Teacher ne kya kaha" type sawaal nahi, concept/application type. Har concept se alag sawaal, repeat nahi.
- 4 options, sirf 1 sahi (correct_index 0-3), galat options believable hon.
- "explanation": 1-2 line, kyun sahi hai.
- "timestamp_seconds": us concept ka time.

STRICT: sirf neeche diye segments ki jaankari use karo. Bahar ka kuch mat jodo.

SEGMENTS:
${segmentsToText(segs)}`;

  const res = await callGemini(
    [{ role: 'user', parts: [{ text: prompt }] }],
    { responseMimeType: 'application/json', responseSchema: chapterSchema, maxOutputTokens: 14000 },
    stop
  );
  const data = parseJson(res?.text);

  const sections: NoteSection[] = (data.sections || []).map((s: NoteSection) => ({
    ...s,
    start_sec: clamp(Math.round(s.start_sec || ch.start_sec), ch.start_sec, ch.end_sec),
    points: s.points || [],
  }));

  const mcqs: MCQ[] = (data.mcqs || [])
    .filter(
      (q: any) =>
        q?.question &&
        Array.isArray(q.options) &&
        q.options.length === 4 &&
        Number.isInteger(q.correct_index) &&
        q.correct_index >= 0 &&
        q.correct_index < 4
    )
    .map((q: any, k: number) => {
      const correctText = q.options[q.correct_index];
      const opts = shuffle<string>(q.options);
      return {
        id: `${ch.start_sec}-${k}`,
        question: q.question,
        options: opts,
        correct_index: opts.indexOf(correctText),
        explanation: q.explanation || '',
        timestamp_seconds: clamp(Math.round(q.timestamp_seconds || ch.start_sec), ch.start_sec, ch.end_sec),
        chapter: ch.title,
      } as MCQ;
    });

  return {
    notes: {
      intro: data.intro,
      sections,
      terms: data.terms || [],
      important_points: data.important_points || [],
      quick_revision: data.quick_revision || [],
      mindmap: data.mindmap,
    },
    mcqs,
  };
}

/* =================== STEP 4: board diagram -> AI image =================== */
async function planBoardVisual(videoUrl: string, item: BoardItem, lang: LangProfile, stop: Stop): Promise<VisualPlan> {
  const start = Math.max(0, item.best_t - 8);
  const end = item.best_t + 8;
  const labelRule =
    CONFIG.IMAGE_LABELS === 'english'
      ? 'Saari labels ko chhote saaf English/Roman shabdon mein likho.'
      : 'Labels waise hi likho jaise board par likhe hain (Hindi ho toh Devanagari, symbols/numbers waise ke waise).';

  const prompt = `Is clip (${fmt(start)}-${fmt(end)}) mein teacher ne board/screen par "${item.title}" (${item.kind}) banaya hai. Pehle ka note: ${item.description}

Clip ko dhyan se dekho aur decide karo:
- "needs_image" = true agar yahan asli drawing hai (circuit, diagram, graph, ray/geometry figure, structure, flowchart, table) jo samajhne ke liye visual maangti hai. Sirf heading/word/simple line ho toh false.
- "reason": 1 line mein, ye image kya dikhati hai (caption), language: ${MEDIUM_NAME[lang.medium]}.
- "labels": board par jo bhi text/labels/values/symbols dikh rahe hain. ${labelRule}
- "image_prompt": ENGLISH mein bahut detailed instruction: kaun si shapes/components kahan hain (left/right/top/bottom), kaun kisse kaise juda hai, arrows ki direction, har label kis jagah hai, axes/values (graph ho toh curve ka shape). Sirf wahi jo video mein dikh raha hai.`;

  const res = await callGemini(
    [
      {
        role: 'user',
        parts: [
          { fileData: { fileUri: videoUrl }, videoMetadata: { startOffset: `${start}s`, endOffset: `${end}s` } },
          { text: prompt },
        ],
      },
    ],
    {
      responseMimeType: 'application/json',
      responseSchema: planSchema,
      mediaResolution: 'MEDIA_RESOLUTION_HIGH' as any,
      maxOutputTokens: 2048,
    },
    stop
  );
  const p = parseJson(res?.text) as VisualPlan;
  return { ...p, labels: p.labels || [] };
}

async function generateAiVisual(plan: VisualPlan, item: BoardItem, stop: Stop): Promise<GeneratedVisual | null> {
  const labelsLine = plan.labels.length ? `Write ONLY these labels, spelled exactly, nothing else: ${plan.labels.join(' | ')}.` : '';
  try {
    const imgRes = await callGemini(
      [
        {
          role: 'user',
          parts: [
            {
              text: `Draw this exactly as described, like a neat hand-drawn diagram in a student's notebook.
${plan.image_prompt}
${labelsLine}
Style: plain white paper background (NOT black, NOT a blackboard, no texture, no shadows), dark blue/black pen lines, small touches of red and green for emphasis, large readable labels, flat 2D, no watermark. Do not add anything that is not described.`,
            },
          ],
        },
      ],
      { responseModalities: ['IMAGE', 'TEXT'] as any },
      stop,
      [CONFIG.IMAGE_MODEL]
    );
    const parts = imgRes?.candidates?.[0]?.content?.parts || [];
    for (const p of parts) {
      const d = (p as any).inlineData;
      if (d?.data) {
        return { kind: 'img', content: `data:${d.mimeType || 'image/png'};base64,${d.data}`, caption: plan.reason || item.description };
      }
    }
  } catch (e: any) {
    if (String(e?.message) === 'CANCELLED') throw e;
    console.warn('Image model fail, SVG fallback:', e);
  }

  try {
    const svgRes = await callGemini(
      [
        {
          role: 'user',
          parts: [
            {
              text: `Create a clean, well-labeled educational diagram as inline <svg viewBox="0 0 640 360" xmlns="http://www.w3.org/2000/svg"> on a white background with clear text labels.
Subject: ${item.title}
Details: ${plan.image_prompt}
${labelsLine}
Return ONLY the <svg>...</svg> markup, no markdown fences.`,
            },
          ],
        },
      ],
      { maxOutputTokens: 3500 },
      stop
    );
    const svg = sanitizeSvg(svgRes?.text || '');
    if (svg) return { kind: 'svg', content: svg, caption: plan.reason || item.description };
  } catch (e: any) {
    if (String(e?.message) === 'CANCELLED') throw e;
    console.warn('SVG fallback fail:', e);
  }
  return null;
}

/* =================== Helpers: chunks, board selection, placement =================== */
function makeChunks(durationSec: number): { start: number; end: number }[] {
  const out: { start: number; end: number }[] = [];
  for (let s = 0; s < durationSec; s += CONFIG.CHUNK_SEC) out.push({ start: s, end: Math.min(s + CONFIG.CHUNK_SEC, durationSec) });
  return out;
}

function selectBoard(all: BoardItem[]): BoardItem[] {
  const sorted = [...all].sort((a, b) => a.best_t - b.best_t);
  const kept: BoardItem[] = [];
  const seenId = new Set<string>();
  for (const b of sorted) {
    const dup = kept.some((k) => k.title.trim().toLowerCase() === b.title.trim().toLowerCase() && Math.abs(k.best_t - b.best_t) < 90);
    if (dup || seenId.has(b.id)) continue;
    seenId.add(b.id);
    kept.push(b);
  }
  return kept
    .filter((b) => b.importance >= 2)
    .sort((a, b) => b.importance - a.importance || a.best_t - b.best_t)
    .slice(0, CONFIG.MAX_VISUALS)
    .sort((a, b) => a.best_t - b.best_t);
}

function sectionIndexFor(ch: ChapterNotes, b: BoardItem): number {
  const n = ch.sections.length;
  if (n === 0) return -1;
  let idx = 0;
  ch.sections.forEach((s, i) => {
    if (s.start_sec <= b.best_t + 5) idx = i;
  });
  return idx;
}

function dedupeMcqs(chapterMcqs: MCQ[][]): MCQ[] {
  const out: MCQ[] = [];
  const sets: Set<string>[] = [];
  for (const list of chapterMcqs) {
    for (const q of list || []) {
      const ts = tokenSet(q.question);
      if (sets.some((s) => isSimilar(s, ts))) continue;
      sets.push(ts);
      out.push(q);
    }
  }
  return out;
}

/* =================== YouTube IFrame API (player + duration + seek) =================== */
function loadYT(): Promise<any> {
  const w = window as any;
  if (w.YT?.Player) return Promise.resolve(w.YT);
  return new Promise((res) => {
    const prev = w.onYouTubeIframeAPIReady;
    w.onYouTubeIframeAPIReady = () => {
      prev?.();
      res(w.YT);
    };
    if (!document.getElementById('yt-iframe-api')) {
      const s = document.createElement('script');
      s.id = 'yt-iframe-api';
      s.src = 'https://www.youtube.com/iframe_api';
      document.head.appendChild(s);
    }
  });
}

function useYouTube(videoId: string | null, mountRef: React.RefObject<HTMLDivElement | null>) {
  const playerRef = useRef<any>(null);
  const [duration, setDuration] = useState(0);

  useEffect(() => {
    if (!videoId) return;
    let cancelled = false;
    let poll: number | undefined;
    setDuration(0);
    loadYT().then((YT) => {
      const host = mountRef.current;
      if (cancelled || !host) return;
      host.innerHTML = '';
      const el = document.createElement('div');
      host.appendChild(el);
      playerRef.current = new YT.Player(el, {
        videoId,
        width: '100%',
        height: '100%',
        playerVars: { rel: 0, modestbranding: 1, playsinline: 1 },
        events: {
          onReady: () => {
            let tries = 0;
            poll = window.setInterval(() => {
              const d = playerRef.current?.getDuration?.() || 0;
              if (d > 0 || ++tries > 20) {
                window.clearInterval(poll);
                if (d > 0 && !cancelled) setDuration(Math.round(d));
              }
            }, 500);
          },
        },
      });
    });
    return () => {
      cancelled = true;
      if (poll) window.clearInterval(poll);
      try {
        playerRef.current?.destroy();
      } catch {
        /* ignore */
      }
      playerRef.current = null;
    };
  }, [videoId, mountRef]);

  const seek = useCallback((s: number) => {
    const p = playerRef.current;
    if (p?.seekTo) {
      p.seekTo(Math.max(0, s), true);
      p.playVideo?.();
    }
  }, []);

  return { duration, seek };
}

/* ============================== Mind map ============================== */
const MM_COLORS = ['#dc2626', '#2563eb', '#16a34a', '#d97706', '#7c3aed', '#db2777'];

function wrap(s: string, n: number): string[] {
  const words = s.split(' ');
  const lines: string[] = [];
  let cur = '';
  for (const w of words) {
    if ((cur + ' ' + w).trim().length > n) {
      if (cur) lines.push(cur);
      cur = w;
    } else cur = (cur + ' ' + w).trim();
  }
  if (cur) lines.push(cur);
  return lines.slice(0, 3);
}

function MMNode({ x, y, text, color, big }: { x: number; y: number; text: string; color: string; big?: boolean }) {
  const lines = wrap(text, big ? 16 : 14);
  const fs = big ? 22 : 17;
  const w = Math.max(...lines.map((l) => l.length), 1) * fs * 0.62 + 20;
  const h = lines.length * (fs + 4) + 12;
  return (
    <g>
      <rect x={x - w / 2} y={y - h / 2} width={w} height={h} rx={big ? 18 : 12} fill={big ? color : '#ffffff'} stroke={color} strokeWidth={2.5} />
      {lines.map((l, i) => (
        <text
          key={i}
          x={x}
          y={y - h / 2 + 8 + (i + 1) * (fs + 4) - 4}
          textAnchor="middle"
          fontSize={fs}
          fontWeight={big ? 700 : 400}
          fill={big ? '#fff' : color}
          style={{ fontFamily: "'Kalam', cursive" }}
        >
          {l}
        </text>
      ))}
    </g>
  );
}

function MindMap({ data }: { data: MindMapData }) {
  const W = 900;
  const H = 560;
  const cx = W / 2;
  const cy = H / 2;
  const n = data.branches.length;
  if (n === 0) return null;
  return (
    <svg viewBox={`0 0 ${W} ${H}`} className="w-full" style={{ background: '#fff', border: '2px solid #cbd5e1', borderRadius: 12 }}>
      {data.branches.map((b, i) => {
        const a = (2 * Math.PI * i) / n - Math.PI / 2;
        const color = MM_COLORS[i % MM_COLORS.length];
        const bx = cx + 190 * Math.cos(a);
        const by = cy + 125 * Math.sin(a);
        return (
          <g key={i}>
            <line x1={cx} y1={cy} x2={bx} y2={by} stroke={color} strokeWidth={3} />
            {(b.children || []).slice(0, 4).map((c, k, arr) => {
              const ca = a + (k - (arr.length - 1) / 2) * 0.3;
              const kx = cx + 345 * Math.cos(ca);
              const ky = cy + 232 * Math.sin(ca);
              return (
                <g key={k}>
                  <line x1={bx} y1={by} x2={kx} y2={ky} stroke={color} strokeWidth={1.5} strokeDasharray="4 3" />
                  <MMNode x={kx} y={ky} text={c} color={color} />
                </g>
              );
            })}
            <MMNode x={bx} y={by} text={b.label} color={color} />
          </g>
        );
      })}
      <MMNode x={cx} y={cy} text={data.center} color="#111827" big />
    </svg>
  );
}

/* ============================ Notebook view ============================ */
function NotesDoc({
  chapters,
  visuals,
  regenId,
  labels = UI.hinglish,
  onJump,
  onRegen,
}: {
  chapters: ChapterNotes[];
  visuals: Record<string, GeneratedVisual>;
  regenId?: string | null;
  labels?: UILabels;
  onJump?: (s: number) => void;
  onRegen?: (id: string) => void;
}) {
  const Jump = ({ s }: { s: number }) =>
    onJump ? (
      <button className="no-print nb-btn" onClick={() => onJump(s)}>
        ▶ {fmt(s)}
      </button>
    ) : null;

  const renderFigure = (b: BoardItem) => {
    const vis = visuals[b.id];
    if (!vis) return null;
    return (
      <figure key={b.id} className="nb-frame avoid-break">
        {vis.kind === 'img' ? (
          <img src={vis.content} alt={b.title} style={{ width: '100%', display: 'block', mixBlendMode: 'multiply' }} />
        ) : (
          <div style={{ width: '100%', overflowX: 'auto' }} dangerouslySetInnerHTML={{ __html: vis.content }} />
        )}
        <figcaption>
          ✏️ <b>{b.title}</b> - {vis.caption}
          <span style={{ marginLeft: 8 }}>
            <Jump s={b.best_t} />
          </span>
          {onRegen && (
            <button className="no-print nb-btn" style={{ marginLeft: 6, background: '#7c3aed' }} disabled={regenId === b.id} onClick={() => onRegen(b.id)}>
              {regenId === b.id ? 'ban rahi hai...' : '🔄 Dobara banao'}
            </button>
          )}
        </figcaption>
      </figure>
    );
  };

  return (
    <div className="notebook">
      {chapters.map((ch, ci) => {
        const bySection: Record<number, BoardItem[]> = {};
        ch.board_visuals.forEach((b) => {
          const si = sectionIndexFor(ch, b);
          (bySection[si] = bySection[si] || []).push(b);
        });
        return (
          <section key={ci} id={`ch-${ci}`} style={{ marginBottom: 44 }}>
            <h2 className="nb-title">
              {ci + 1}. {ch.title}
              <Jump s={ch.start_sec} />
            </h2>
            {ch.intro && <p className="nb-intro">{ch.intro}</p>}

            {ch.mindmap && ch.mindmap.branches?.length > 0 && (
              <div className="avoid-break" style={{ margin: '12px 0' }}>
                <h3 className="nb-h3">🧠 {labels.mind}</h3>
                <MindMap data={ch.mindmap} />
              </div>
            )}

            {ch.sections.map((s, si) => (
              <div key={si}>
                <div className="avoid-break">
                  <h3 className="nb-h3">
                    {ci + 1}.{si + 1} {s.heading} <Jump s={s.start_sec} />
                  </h3>
                  {s.definition && (
                    <div className="nb-def">
                      <b>📖 {labels.def}:</b> {s.definition}
                    </div>
                  )}
                  {s.intuition && (
                    <div className="nb-intu">
                      <b>💡 {labels.intu}:</b> {s.intuition}
                    </div>
                  )}
                  <ul className="nb-ul">
                    {s.points.map((p, pi) => (
                      <li key={pi}>{p}</li>
                    ))}
                  </ul>
                  {s.formulas?.map((f, fi) => (
                    <div key={fi} className="nb-formula">
                      ✎ {f}
                    </div>
                  ))}
                  {s.examples?.map((e, ei) => (
                    <div key={ei} className="nb-example">
                      <b>🌍 {labels.ex}:</b> {e}
                    </div>
                  ))}
                  {s.exam_tip && (
                    <div className="nb-tip">
                      <span className="nb-hl">⭐ {s.exam_tip}</span>
                    </div>
                  )}
                </div>
                {(bySection[si] || []).map(renderFigure)}
              </div>
            ))}
            {(bySection[-1] || []).map(renderFigure)}

            {ch.important_points.length > 0 && (
              <div className="nb-imp avoid-break">
                <div className="nb-imp-title">⭐ {labels.imp} ⭐</div>
                <ul className="nb-ul">
                  {ch.important_points.map((p, i) => (
                    <li key={i}>
                      <span className="nb-hl">{p}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {ch.terms.length > 0 && (
              <div className="avoid-break">
                <h3 className="nb-h3">📌 {labels.terms}</h3>
                <table className="nb-table">
                  <tbody>
                    {ch.terms.map((t, ti) => (
                      <tr key={ti}>
                        <td style={{ color: '#dc2626', fontWeight: 700, width: '32%' }}>{t.term}</td>
                        <td>{t.meaning}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}

            {ch.quick_revision.length > 0 && (
              <div className="nb-rev avoid-break">
                <div className="nb-rev-title">⚡ {labels.rev}</div>
                <ul className="nb-ul">
                  {ch.quick_revision.map((p, i) => (
                    <li key={i}>{p}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        );
      })}
    </div>
  );
}

