  const [subjectHint, setSubjectHint] = useState<SubjectHint>('auto');
  const [videoTitle, setVideoTitle] = useState('');
  const [lang, setLang] = useState<LangProfile | null>(null);

  const playerHost = useRef<HTMLDivElement | null>(null);
  const videoId = useMemo(() => extractVideoId(url.trim()), [url]);
  const { duration: detected, seek } = useYouTube(videoId, playerHost);
  const durationSec = manualMin ? Math.round(Number(manualMin) * 60) : detected;

  useEffect(() => {
    setVideoTitle('');
    if (!videoId) return;
    let alive = true;
    fetchTitle(videoId).then((t) => {
      if (alive) setVideoTitle(t);
    });
    return () => {
      alive = false;
    };
  }, [videoId]);

  const stop = useRef<Stop>({ current: false });

  const [running, setRunning] = useState(false);
  const [phase, setPhase] = useState<Phase>('idle');
  const [chunkStates, setChunkStates] = useState<ChunkState[]>([]);
  const [chaptersTotal, setChaptersTotal] = useState(0);
  const [chaptersDone, setChaptersDone] = useState(0);
  const [imagesTotal, setImagesTotal] = useState(0);
  const [imagesDone, setImagesDone] = useState(0);
  const [error, setError] = useState('');

  const [chapters, setChapters] = useState<ChapterNotes[]>([]);
  const [visuals, setVisuals] = useState<Record<string, GeneratedVisual>>({});
  const [regenId, setRegenId] = useState<string | null>(null);
  const [mcqs, setMcqs] = useState<MCQ[]>([]);
  const [answers, setAnswers] = useState<Record<string, number>>({});
  const [quizChapter, setQuizChapter] = useState('all');
  const [tab, setTab] = useState<'notes' | 'quiz'>('notes');
  const [printMode, setPrintMode] = useState<'notes' | 'quiz' | null>(null);

  const jump = (s: number) => {
    seek(s);
    playerHost.current?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  };

  const setCS = (i: number, st: ChunkState) =>
    setChunkStates((prev) => {
      const n = [...prev];
      n[i] = st;
      return n;
    });

  const doPrint = (mode: 'notes' | 'quiz') => {
    setPrintMode(mode);
    setTimeout(() => {
      window.print();
      setPrintMode(null);
    }, 900);
  };

  const run = async () => {
    if (!videoId) return setError('Sahi YouTube URL paste karo.');
    if (!durationSec) return setError('Video ki length detect nahi hui. "Length (min)" box mein khud daalo.');

    const stopObj: Stop = stop.current;
    stopObj.current = false;

    setError('');
    setRunning(true);
    setChapters([]);
    setMcqs([]);
    setVisuals({});
    setAnswers({});
    setImagesDone(0);
    setImagesTotal(0);
    setChaptersDone(0);
    setChaptersTotal(0);
    setLang(null);

    const base = `${CONFIG.CACHE_V}:${videoId}:${CONFIG.CHUNK_SEC}`;
    const videoUrl = `https://www.youtube.com/watch?v=${videoId}`;

    try {
      let title = videoTitle;
      if (!title) {
        title = await fetchTitle(videoId);
        setVideoTitle(title);
      }

      /* ---- 1. ANALYZE ---- */
      setPhase('analyze');
      const chunks = makeChunks(durationSec);
      setChunkStates(chunks.map(() => 'pending'));
      const digests: (ChunkDigest | undefined)[] = new Array(chunks.length);
      const failures: string[] = [];

      await runPool(
        chunks,
        CONFIG.CONCURRENCY,
        async (c, i) => {
          const key = `${base}:dig:${c.start}-${c.end}`;
          const hit = await cget<ChunkDigest>(key);
          if (hit) {
            digests[i] = hit;
            setCS(i, 'cached');
            return;
          }
          setCS(i, 'running');
          try {
            const d = await fetchDigest(videoUrl, c.start, c.end, stopObj, { title, withMeta: i === 0 });
            digests[i] = d;
            await cset(key, d);
            setCS(i, 'done');
          } catch (e: any) {
            if (String(e?.message) === 'CANCELLED') throw e;
            setCS(i, 'failed');
            failures.push(`${fmt(c.start)}-${fmt(c.end)}: ${String(e?.message || e).slice(0, 120)}`);
          }
        },
        stopObj
      );
      if (stopObj.current) throw new Error('CANCELLED');
      if (failures.length) {
        throw new Error(
          `${failures.length} chunk fail hue (${failures[0]}). Dobara Generate dabao - jo ban chuka hai wo cache se aayega, sirf fail wale dobara chalenge.`
        );
      }

      const allSegs = digests.flatMap((d) => d?.segments || []).sort((a, b) => a.t - b.t);
      const allBoard = digests.flatMap((d) => d?.board || []);
      if (allSegs.length === 0) throw new Error('Video se koi content nahi mila. Kya video public hai aur usme awaaz hai?');
      const selected = imagesOn ? selectBoard(allBoard) : [];

      // pehle chunk ke meta + user ke choice se notes ki bhasha tay hoti hai
      const langP = resolveLang(langMode, subjectHint, digests[0]?.meta ?? DEFAULT_META);
      setLang(langP);

      /* ---- 2. OUTLINE ---- */
      setPhase('outline');
      const outKey = `${base}:${langP.key}:outline:${durationSec}`;
      let outline = await cget<Chapter[]>(outKey);
      if (!outline) {
        outline = await buildOutline(allSegs, durationSec, langP, stopObj);
        await cset(outKey, outline);
      }

      /* ---- 3. NOTES + MCQs ---- */
      setPhase('notes');
      setChaptersTotal(outline.length);
      const results: ({ notes: ChapterContent; mcqs: MCQ[] } | undefined)[] = new Array(outline.length);
      let done = 0;
      const publish = () => {
        const built: ChapterNotes[] = [];
        outline!.forEach((ch, i) => {
          const r = results[i];
          if (!r) return;
          built.push({
            ...ch,
            ...r.notes,
            board_visuals: selected.filter((b) => b.best_t >= ch.start_sec && b.best_t < ch.end_sec + (i === outline!.length - 1 ? 1 : 0)),
          });
        });
        setChapters(built);
        setMcqs(dedupeMcqs(results.map((r) => r?.mcqs || [])));
      };

      await runPool(
        outline,
        CONFIG.CHAPTER_CONCURRENCY,
        async (ch, i) => {
          const key = `${base}:${langP.key}:ch:${ch.start_sec}-${ch.end_sec}`;
          let r = await cget<{ notes: ChapterContent; mcqs: MCQ[] }>(key);
          if (!r) {
            r = await buildChapter(ch, allSegs, langP, stopObj);
            await cset(key, r);
          }
          results[i] = r;
          done++;
          setChaptersDone(done);
          publish();
        },
        stopObj
      );
      if (stopObj.current) throw new Error('CANCELLED');

      /* ---- 4. IMAGES (progressive) ---- */
      if (selected.length > 0) {
        setPhase('images');
        setImagesTotal(selected.length);
        let imgDone = 0;
        await runPool(
          selected,
          CONFIG.IMAGE_CONCURRENCY,
          async (item) => {
            const key = `${base}:${langP.key}:vis:${item.id}`;
            try {
              const cached = await cget<CachedVisual>(key);
              if (cached) {
                if ('kind' in cached) setVisuals((p) => ({ ...p, [item.id]: cached }));
                return;
              }
              const plan = await planBoardVisual(videoUrl, item, langP, stopObj);
              if (!plan.needs_image) {
                await cset(key, { skip: true });
                return;
              }
              const vis = await generateAiVisual(plan, item, stopObj);
              if (vis) {
                setVisuals((p) => ({ ...p, [item.id]: vis }));
                await cset(key, vis);
              }
            } catch (e: any) {
              if (String(e?.message) === 'CANCELLED') throw e;
              console.warn('visual fail', item.id, e); // ek image fail hone se poora kaam nahi rukna chahiye
            } finally {
              imgDone++;
              setImagesDone(imgDone);
            }
          },
          stopObj
        );
      }

      setPhase('done');
    } catch (e: any) {
      if (String(e?.message) === 'CANCELLED') {
        setError('Rok diya gaya. Dobara Generate dabaoge toh wahin se resume hoga.');
      } else {
        console.error(e);
        setError(String(e?.message || 'Kuch gadbad ho gayi.'));
      }
      setPhase('idle');
    } finally {
      setRunning(false);
    }
  };

  const regenerate = async (id: string) => {
    if (!videoId || !lang) return;
    const item = chapters.flatMap((c) => c.board_visuals).find((b) => b.id === id);
    if (!item) return;
    const stopObj: Stop = { current: false };
    setRegenId(id);
    try {
      const plan = await planBoardVisual(`https://www.youtube.com/watch?v=${videoId}`, item, lang, stopObj);
      const vis = await generateAiVisual({ ...plan, needs_image: true }, item, stopObj);
      if (vis) {
        setVisuals((p) => ({ ...p, [id]: vis }));
        await cset(`${CONFIG.CACHE_V}:${videoId}:${CONFIG.CHUNK_SEC}:${lang.key}:vis:${id}`, vis);
      } else setError('Image dobara nahi ban payi. Thodi der baad try karo.');
    } catch (e: any) {
      setError(String(e?.message || 'Regenerate fail hua.'));
    } finally {
      setRegenId(null);
    }
  };

  const clearCache = async () => {
    await cclear();
    setError('Cache clear ho gaya. Ab Generate naye sire se chalega.');
  };

  /* ---------- derived ---------- */
  const phaseIdx = ORDER.indexOf(phase);
  const chunksDone = chunkStates.filter((s) => s === 'done' || s === 'cached').length;
  const pct = (() => {
    if (phase === 'idle') return 0;
    if (phase === 'done') return 100;
    const a = chunkStates.length ? chunksDone / chunkStates.length : 0;
    const c = chaptersTotal ? chaptersDone / chaptersTotal : 0;
    const im = imagesTotal ? imagesDone / imagesTotal : 0;
    return Math.round(a * 50 + (phaseIdx >= 3 ? 5 : 0) + c * 30 + im * 15);
  })();

  const quizList = quizChapter === 'all' ? mcqs : mcqs.filter((q) => q.chapter === quizChapter);
  const quizChapters = Array.from(new Set(mcqs.map((q) => q.chapter)));
  const attempted = quizList.filter((q) => answers[q.id] !== undefined).length;
  const score = quizList.filter((q) => answers[q.id] === q.correct_index).length;
  const hasContent = chapters.length > 0 || mcqs.length > 0;

  const chipStyle: Record<ChunkState, string> = {
    pending: 'bg-slate-200',
    running: 'bg-amber-400 animate-pulse',
    done: 'bg-emerald-500',
    cached: 'bg-sky-400',
    failed: 'bg-rose-500',
  };

  return (
    <>
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Kalam:wght@300;400;700&display=swap');
        .print-only { display: none; }
        .avoid-break { break-inside: avoid; }
        .notebook {
          font-family: 'Kalam', cursive; color: #1e3a8a; font-size: 18px; line-height: 32px;
          background-color: #fffef8;
          background-image: repeating-linear-gradient(to bottom, transparent 0, transparent 31px, #cfe3f5 31px, #cfe3f5 32px);
          padding: 20px 24px 20px 60px; border-left: 3px solid #f87171; border-radius: 12px;
          -webkit-print-color-adjust: exact; print-color-adjust: exact;
        }
        .nb-title { font-size: 28px; line-height: 44px; font-weight: 700; color: #dc2626;
          text-decoration: underline wavy #dc2626; text-underline-offset: 6px; margin-bottom: 8px; display:flex; gap:10px; align-items:center; flex-wrap:wrap; }
        .nb-intro { color: #475569; }
        .nb-h3 { font-size: 21px; font-weight: 700; color: #1d4ed8; margin-top: 12px; display:flex; gap:8px; align-items:center; flex-wrap:wrap;
          text-decoration: underline; text-decoration-color: #f59e0b; text-decoration-thickness: 3px; text-underline-offset: 5px; }
        .nb-def { border-left: 4px solid #2563eb; background: #eff6ffcc; padding: 2px 12px; margin: 6px 0; color: #1e3a8a; }
        .nb-intu { border-left: 4px solid #7c3aed; background: #f5f3ffcc; padding: 2px 12px; margin: 6px 0; color: #4c1d95; }
        .nb-ul { list-style: none; padding: 0; margin: 0; }
        .nb-ul li { padding-left: 26px; position: relative; }
        .nb-ul li::before { content: '➤'; position: absolute; left: 0; color: #059669; }
        .nb-formula { display: inline-block; border: 2px solid #16a34a; color: #15803d; background: #f0fdf4;
          border-radius: 10px; padding: 0 14px; margin: 6px 8px 6px 0; font-weight: 700; }
        .nb-example { border-left: 4px solid #ea580c; background: #fff7edcc; padding: 2px 12px; margin: 6px 0; color: #9a3412; }
        .nb-tip { margin: 4px 0; color: #b91c1c; font-weight: 700; }
        .nb-imp { background: #fef9c3; border: 2px dashed #dc2626; border-radius: 12px; padding: 6px 16px; margin: 14px 0; }
        .nb-imp-title { color: #dc2626; font-weight: 700; font-size: 20px; }
        .nb-rev { background: #ecfdf5; border: 2px solid #10b981; border-radius: 12px; padding: 6px 16px; margin: 14px 0; }
        .nb-rev-title { color: #047857; font-weight: 700; font-size: 20px; }
        .nb-hl { background: linear-gradient(transparent 35%, #fde047 35%); }
        .nb-frame { margin: 16px 0; padding: 8px; border: 2px dashed #93c5fd; border-radius: 10px; background: transparent; }
        .nb-frame figcaption { font-size: 16px; line-height: 24px; color: #6d28d9; margin-top: 6px; }
        .nb-table { width: 100%; border-collapse: collapse; }
        .nb-table td { border: 1px solid #93c5fd; padding: 0 10px; vertical-align: top; }
        .nb-btn { font-family: system-ui, sans-serif; font-size: 12px; line-height: 1; background: #2563eb; color: #fff;
          padding: 5px 8px; border-radius: 6px; cursor: pointer; border: 0; font-weight: 600; text-decoration: none; }
        .nb-btn:disabled { opacity: .5; cursor: default; }
        @page { margin: 12mm; }
        @media print {
          .screen-only, .no-print { display: none !important; }
          .print-only { display: block !important; }
        }
      `}</style>

      {/* ---------------- SCREEN ---------------- */}
      <div className="screen-only min-h-screen bg-slate-50 text-slate-900" style={{ fontFamily: 'system-ui, sans-serif' }}>
        <header className="bg-white border-b border-slate-200">
          <div className="max-w-7xl mx-auto px-4 py-3 flex items-center gap-3">
            <div className="w-9 h-9 rounded-xl bg-indigo-600 text-white grid place-items-center font-bold">R</div>
            <div>
              <h1 className="text-lg font-bold leading-tight">Raftaar Notes Studio</h1>
              <p className="text-xs text-slate-500">YouTube lecture se student-style notes, diagrams aur quiz</p>
            </div>
          </div>
        </header>

        <main className="max-w-7xl mx-auto px-4 py-6 grid lg:grid-cols-[380px_1fr] gap-6">
          {/* -------- LEFT: input, player, chapters -------- */}
          <aside className="space-y-4 lg:sticky lg:top-4 self-start">
            <div className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-3">
              <label className="text-sm font-semibold">YouTube lecture URL</label>
              <input
                value={url}
                onChange={(e) => setUrl(e.target.value)}
                placeholder="https://www.youtube.com/watch?v=..."
                className="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100"
              />
              {url && !videoId && <p className="text-xs text-rose-600">Ye sahi YouTube link nahi lag raha.</p>}

              <div className="flex items-center gap-2 text-sm">
                <div className="flex-1 bg-slate-100 rounded-lg px-3 py-2">
                  {detected > 0 ? (
                    <span>
                      ⏱ Length: <b>{fmt(detected)}</b> · {makeChunks(durationSec || detected).length} chunks
                    </span>
                  ) : (
                    <span className="text-slate-500">{videoId ? 'Length detect ho rahi hai...' : 'Length auto-detect hogi'}</span>
                  )}
                </div>
                <input
                  type="number"
                  min="1"
                  max="600"
                  value={manualMin}
                  onChange={(e) => setManualMin(e.target.value)}
                  placeholder="min"
                  title="Auto-detect fail ho toh yahan minutes daalo"
                  className="w-20 border border-slate-300 rounded-lg px-2 py-2 text-sm outline-none focus:border-indigo-500"
                />
              </div>

              <label className="flex items-center gap-2 text-sm cursor-pointer">
                <input type="checkbox" checked={imagesOn} onChange={(e) => setImagesOn(e.target.checked)} />
                Board ke diagrams AI se banao <span className="text-slate-400">(extra time + cost)</span>
              </label>

              <div className="grid grid-cols-2 gap-2 text-sm">
                <label className="space-y-1">
                  <span className="text-xs text-slate-500">Notes ki bhasha</span>
                  <select
                    value={langMode}
                    onChange={(e) => setLangMode(e.target.value as LangMode)}
                    disabled={running}
                    className="w-full border border-slate-300 rounded-lg px-2 py-1.5 text-sm bg-white"
                  >
                    <option value="auto">Auto Detect</option>
                    <option value="english">English Medium</option>
                    <option value="hindi">Hindi Medium</option>
                  </select>
                </label>
                <label className="space-y-1">
                  <span className="text-xs text-slate-500">Subject</span>
                  <select
                    value={subjectHint}
                    onChange={(e) => setSubjectHint(e.target.value as SubjectHint)}
                    disabled={running}
                    className="w-full border border-slate-300 rounded-lg px-2 py-1.5 text-sm bg-white"
                  >
                    <option value="auto">Auto</option>
                    <option value="english">English Subject</option>
                    <option value="science">Science / Maths</option>
                    <option value="social">Social Science / Other</option>
                  </select>
                </label>
              </div>
              <p className="text-xs text-slate-400">Bhasha badalne par video dobara analyse nahi hoti, sirf notes + quiz naye bante hain.</p>
              {lang && (
                <p className="text-xs bg-indigo-50 text-indigo-700 rounded-lg px-3 py-2">
                  🌐 Detected: <b>{lang.subject}</b> · {lang.board} · Notes: <b>{MEDIUM_NAME[lang.medium]}</b>
                  {lang.pureEnglish ? ' (English subject)' : ''}
                </p>
              )}

              <div className="flex gap-2">
                <button
                  onClick={run}
                  disabled={running || !videoId}
                  className="flex-1 bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white rounded-lg py-2.5 text-sm font-semibold cursor-pointer"
                >
                  {running ? 'Processing...' : hasContent ? 'Resume / Dobara Generate' : 'Generate Notes + Quiz'}
                </button>
                {running && (
                  <button
                    onClick={() => {
                      stop.current.current = true;
                    }}
                    className="px-4 rounded-lg border border-slate-300 text-sm hover:bg-slate-100 cursor-pointer"
                  >
                    Stop
                  </button>
                )}
              </div>
              <button onClick={clearCache} className="text-xs text-slate-500 underline cursor-pointer">
                Cache clear (naye sire se banana ho toh)
              </button>
            </div>

            {videoId && (
              <div className="bg-black rounded-2xl overflow-hidden border border-slate-200 shadow-sm aspect-video">
                <div ref={playerHost} className="w-full h-full" />
              </div>
            )}

            {chapters.length > 0 && (
              <div className="bg-white rounded-2xl border border-slate-200 p-3 shadow-sm">
                <p className="text-sm font-semibold mb-2 px-1">Chapters</p>
                <div className="max-h-72 overflow-y-auto space-y-1">
                  {chapters.map((c, i) => (
                    <div key={i} className="flex items-center gap-2 text-sm hover:bg-slate-50 rounded-lg px-2 py-1.5">
                      <button
                        className="flex-1 text-left truncate cursor-pointer"
                        onClick={() => {
                          setTab('notes');
                          setTimeout(() => document.getElementById(`ch-${i}`)?.scrollIntoView({ behavior: 'smooth' }), 50);
                        }}
                      >
                        {i + 1}. {c.title}
                      </button>
                      <button onClick={() => jump(c.start_sec)} className="text-xs text-indigo-600 font-semibold cursor-pointer">
                        ▶ {fmt(c.start_sec)}
                      </button>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </aside>

          {/* -------- RIGHT: progress + content -------- */}
          <section className="min-w-0 space-y-4">
            {error && <div className="bg-rose-50 border border-rose-200 text-rose-800 rounded-xl p-3 text-sm">{error}</div>}

            {(running || phase === 'done') && (
              <div className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm">
                <div className="flex items-center justify-between mb-3">
                  <div className="flex flex-wrap gap-2">
                    {STEPS.map((s) => {
                      const idx = ORDER.indexOf(s.key);
                      const state = phaseIdx > idx ? 'done' : phaseIdx === idx ? 'active' : 'todo';
                      return (
                        <span
                          key={s.key}
                          className={`text-xs px-2.5 py-1 rounded-full font-medium ${
                            state === 'done'
                              ? 'bg-emerald-100 text-emerald-700'
                              : state === 'active'
                              ? 'bg-indigo-100 text-indigo-700'
                              : 'bg-slate-100 text-slate-400'
                          }`}
                        >
                          {state === 'done' ? '✓ ' : ''}
                          {s.label}
                        </span>
                      );
                    })}
                  </div>
                  <span className="text-sm font-semibold text-slate-600">{pct}%</span>
                </div>
                <div className="h-2 bg-slate-100 rounded-full overflow-hidden">
                  <div className="h-2 bg-indigo-600 transition-all" style={{ width: `${pct}%` }} />
                </div>
                <div className="mt-3 text-xs text-slate-500 space-y-2">
                  {chunkStates.length > 0 && (
                    <div>
                      <p className="mb-1">
                        Video chunks: {chunksDone}/{chunkStates.length}{' '}
                        <span className="text-slate-400">(hara = naya, neela = cache se, peela = chal raha)</span>
                      </p>
                      <div className="flex flex-wrap gap-1">
                        {chunkStates.map((s, i) => (
                          <span key={i} className={`w-3 h-3 rounded-sm ${chipStyle[s]}`} />
                        ))}
                      </div>
                    </div>
                  )}
                  {chaptersTotal > 0 && (
                    <p>
                      Chapters ke notes: {chaptersDone}/{chaptersTotal}
                    </p>
                  )}
                  {imagesTotal > 0 && (
                    <p>
                      Diagrams: {imagesDone}/{imagesTotal} <span className="text-slate-400">(notes tab mein aate jaate hain)</span>
                    </p>
                  )}
                </div>
              </div>
            )}

            {!hasContent && !running && (
              <div className="bg-white rounded-2xl border border-dashed border-slate-300 p-8 text-center text-slate-500">
                <p className="text-lg font-semibold text-slate-700 mb-2">Kaise kaam karta hai</p>
                <p className="text-sm max-w-md mx-auto">
                  Lecture ka link paste karo. Video 10-10 minute ke hisson mein parallel analyse hota hai, phir chapter-wise
                  student-style notes, mind map, diagrams aur quiz banta hai. Beech mein ruk jaye toh dobara dabane par wahin se chalega.
                </p>
              </div>
            )}

            {hasContent && (
              <>
                <div className="flex flex-wrap items-center gap-2 border-b border-slate-200">
                  {(['notes', 'quiz'] as const).map((t) => (
                    <button
                      key={t}
                      onClick={() => setTab(t)}
                      className={`px-4 py-2 text-sm font-semibold border-b-2 -mb-px cursor-pointer ${
                        tab === t ? 'border-indigo-600 text-indigo-600' : 'border-transparent text-slate-500'
                      }`}
                    >
                      {t === 'notes' ? `Notes (${chapters.length} chapters)` : `Quiz (${mcqs.length} MCQs)`}
                    </button>
                  ))}
                  <div className="ml-auto flex gap-2 pb-1">
                    <button onClick={() => doPrint('notes')} className="text-xs bg-white border border-slate-300 hover:bg-slate-50 px-3 py-1.5 rounded-lg cursor-pointer">
                      ⬇ Notes PDF
                    </button>
                    <button onClick={() => doPrint('quiz')} className="text-xs bg-white border border-slate-300 hover:bg-slate-50 px-3 py-1.5 rounded-lg cursor-pointer">
                      ⬇ Quiz PDF
                    </button>
                  </div>
                </div>

                {tab === 'notes' && <NotesDoc chapters={chapters} visuals={visuals} regenId={regenId} labels={UI[lang?.medium ?? 'hinglish']} onJump={jump} onRegen={regenerate} />}

                {tab === 'quiz' && (
                  <div className="space-y-4">
                    <div className="sticky top-0 z-10 bg-white border border-slate-200 rounded-xl p-3 shadow-sm flex flex-wrap items-center gap-3 text-sm">
                      <select
                        value={quizChapter}
                        onChange={(e) => setQuizChapter(e.target.value)}
                        className="border border-slate-300 rounded-lg px-2 py-1.5 text-sm max-w-[220px]"
                      >
                        <option value="all">Saare chapters ({mcqs.length})</option>
                        {quizChapters.map((c) => (
                          <option key={c} value={c}>
                            {c}
                          </option>
                        ))}
                      </select>
                      <span>
                        Attempted: <b>{attempted}</b>/{quizList.length}
                      </span>
                      <span className="font-semibold text-emerald-600">
                        Score: {score}/{attempted}
                        {attempted > 0 && ` (${Math.round((score / attempted) * 100)}%)`}
                      </span>
                      <button onClick={() => setAnswers({})} className="ml-auto text-xs underline text-slate-500 cursor-pointer">
                        Test reset
                      </button>
                    </div>

                    {quizList.map((q, qi) => {
                      const chosen = answers[q.id];
                      const answered = chosen !== undefined;
                      return (
                        <div key={q.id} className="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                          <div className="flex justify-between items-start gap-3 mb-3">
                            <p className="font-semibold text-sm">
                              Q{qi + 1}. {q.question}
                            </p>
                            <button onClick={() => jump(q.timestamp_seconds)} className="shrink-0 text-xs text-indigo-600 font-semibold cursor-pointer">
                              ▶ {fmt(q.timestamp_seconds)}
                            </button>
                          </div>
                          <div className="grid sm:grid-cols-2 gap-2">
                            {q.options.map((opt, oi) => {
                              let style = 'bg-white border-slate-300 hover:border-indigo-400 hover:bg-indigo-50';
                              if (answered) {
                                if (oi === q.correct_index) style = 'bg-emerald-50 border-emerald-500 text-emerald-800';
                                else if (oi === chosen) style = 'bg-rose-50 border-rose-500 text-rose-800';
                                else style = 'bg-slate-50 border-slate-200 text-slate-400';
                              }
                              return (
                                <button
                                  key={oi}
                                  disabled={answered}
                                  onClick={() => setAnswers((p) => ({ ...p, [q.id]: oi }))}
                                  className={`text-left text-sm p-2.5 rounded-lg border transition ${answered ? '' : 'cursor-pointer'} ${style}`}
                                >
                                  <b>{String.fromCharCode(65 + oi)}.</b> {opt}
                                </button>
                              );
                            })}
                          </div>
                          {answered && (
                            <div className="mt-3 text-sm bg-slate-50 border border-slate-200 rounded-lg p-3">
                              <p className={chosen === q.correct_index ? 'text-emerald-600 font-bold' : 'text-rose-600 font-bold'}>
                                {chosen === q.correct_index
                                  ? '✓ Sahi jawab!'
                                  : `✗ Galat. Sahi answer: ${String.fromCharCode(65 + q.correct_index)}. ${q.options[q.correct_index]}`}
                              </p>
                              <p className="mt-1 text-slate-600">
                                <b className="text-indigo-600">Explanation: </b>
                                {q.explanation}
                              </p>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </div>
                )}
              </>
            )}
          </section>
        </main>
      </div>

      {/* ---------------- PRINT (PDF) ---------------- */}
      <div className="print-only">
        {printMode === 'notes' && <NotesDoc chapters={chapters} visuals={visuals} labels={UI[lang?.medium ?? 'hinglish']} />}
        {printMode === 'quiz' && (
          <div style={{ color: '#000', background: '#fff', padding: 16 }}>
            <h1 style={{ fontSize: 22, fontWeight: 700, marginBottom: 12 }}>Quiz - Answer Key ke saath</h1>
            {mcqs.map((q, i) => (
              <div key={q.id} className="avoid-break" style={{ marginBottom: 14, fontSize: 14 }}>
                <p style={{ fontWeight: 600 }}>
                  Q{i + 1}. {q.question} <span style={{ color: '#64748b', fontWeight: 400 }}>[{q.chapter} · {fmt(q.timestamp_seconds)}]</span>
                </p>
                {q.options.map((o, oi) => (
                  <p key={oi} style={{ marginLeft: 16 }}>
                    {String.fromCharCode(65 + oi)}. {o}
                  </p>
                ))}
                <p style={{ marginLeft: 16, marginTop: 4 }}>
                  <b>Answer: {String.fromCharCode(65 + q.correct_index)}</b> - {q.explanation}
                </p>
              </div>
            ))}
          </div>
        )}
      </div>
    </>
  );
}