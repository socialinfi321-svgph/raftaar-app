/* ---------- IndexedDB cache (3 ghante ke data ke liye localStorage kam padta hai) ---------- */
function idbOpen(): Promise<IDBDatabase> {
  return new Promise((res, rej) => {
    const r = indexedDB.open('raftaar-cache', 1);
    r.onupgradeneeded = () => r.result.createObjectStore('kv');
    r.onsuccess = () => res(r.result);
    r.onerror = () => rej(r.error);
  });
}
async function cget<T>(k: string): Promise<T | null> {
  try {
    const db = await idbOpen();
    return await new Promise<T | null>((res) => {
      const q = db.transaction('kv').objectStore('kv').get(k);
      q.onsuccess = () => res((q.result as T) ?? null);
      q.onerror = () => res(null);
    });
  } catch {
    return null;
  }
}
async function cset(k: string, v: unknown) {
  try {
    const db = await idbOpen();
    await new Promise<void>((res) => {
      const tx = db.transaction('kv', 'readwrite');
      tx.objectStore('kv').put(v, k);
      tx.oncomplete = () => res();
      tx.onerror = () => res();
    });
  } catch {
    /* cache fail hua toh bhi kaam chalta rahe */
  }
}
async function cclear() {
  try {
    const db = await idbOpen();
    await new Promise<void>((res) => {
      const tx = db.transaction('kv', 'readwrite');
      tx.objectStore('kv').clear();
      tx.oncomplete = () => res();
      tx.onerror = () => res();
    });
  } catch {
    /* ignore */
  }
}

/* ---------- Bounded concurrency pool ---------- */
type Stop = { current: boolean };
async function runPool<T>(items: T[], limit: number, worker: (item: T, i: number) => Promise<void>, stop: Stop) {
  let next = 0;
  const runners = Array.from({ length: Math.min(limit, items.length) }, async () => {
    while (!stop.current) {
      const i = next++;
      if (i >= items.length) return;
      await worker(items[i], i);
    }
  });
  await Promise.all(runners);
}

/* ---------- Gemini call: shared cooldown + retry + model fallback ---------- */
let pauseUntil = 0; // 429/503 par saare workers ek saath ruk jaate hain
async function callGemini(contents: any, config: any, stop: Stop, models: string[] = CONFIG.MODELS) {
  const waits = [3000, 8000, 16000];
  let lastError: any;
  for (const model of models) {
    for (let i = 0; i <= waits.length; i++) {
      if (stop.current) throw new Error('CANCELLED');
      const w = pauseUntil - Date.now();
      if (w > 0) await sleep(w);
      try {
        return await ai.models.generateContent({ model, contents, config });
      } catch (e: any) {
        lastError = e;
        const msg = String(e?.message || '');
        if (/404|NOT_FOUND/.test(msg)) break; // model band, agla model
        const retryable = /503|UNAVAILABLE|429|RESOURCE_EXHAUSTED|500|INTERNAL|fetch failed|Failed to fetch/i.test(msg);
        if (!retryable) throw e;
        if (i < waits.length) {
          const wait = waits[i] + Math.random() * 1500;
          pauseUntil = Math.max(pauseUntil, Date.now() + wait);
          continue;
        }
        break; // is model par retries khatam, agla model
      }
    }
  }
  throw lastError;
}

